# 深圳数据获取流水线环境模板
# 复制为 .env 后按需修改

# 平台 appKey（必填）
APP_KEY=YOUR_APP_KEY_HERE

# 数据库连接
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gis_db

# 数据集选择：bike | weather_grid
DATASET_PROFILE=bike

# 时间范围（闭区间）
DATA_START_DATE=20210101
DATA_END_DATE=20210830

# 抓取参数
ROWS_PER_PAGE=4000
MAX_CONCURRENCY=30
DAYS_CONCURRENCY=100
MAX_RETRIES=5
RETRY_DELAY_SECONDS=5

# 日志级别：TRACE/DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=INFO

# BAIDU_AK=
