# 优化版数据管道配置示例
# 复制此文件为 .env 并根据实际情况修改配置

# ============ 数据库配置 ============
# PostgreSQL + TimescaleDB 连接信息
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=shenzhen_bike

# 连接超时设置（秒）
CONNECT_TIMEOUT=30

# ============ 表配置 ============
# 主表名
TABLE_NAME=shenzhen_rides

# ============ API配置 ============
# 深圳开放数据平台API密钥（必需）
APP_KEY=your_api_key_here

# API基础URL
API_URL=https://opendata.sz.gov.cn/api/29200_00403627/1/service.xhtml

# ============ 数据获取配置 ============
# 数据日期范围
DATA_START_DATE=20210101
DATA_END_DATE=20210830

# 每页获取记录数（建议5000-10000，过大可能导致超时）
ROWS_PER_PAGE=10000

# 重试配置
MAX_RETRIES=3

# 并发控制
MAX_CONCURRENCY=8        # API请求并发数
DAYS_CONCURRENCY=2       # 同时处理的天数

# ============ 坐标转换配置 ============
# 百度地图API Key（可选，仅用于BD-09坐标转换）
BAIDU_AK=

# 百度坐标转换API URL
BAIDU_GEOCONV_URL=https://api.map.baidu.com/geoconv/v1/

# ============ 日志配置 ============
# 日志级别：DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============ 导出配置 ============
# 默认导出目录
EXPORT_BASE_DIR=data/share

# 并发导出数量
EXPORT_MAX_WORKERS=4

# 批量导出大小
EXPORT_BATCH_SIZE=50000

# ============ TimescaleDB配置 ============
# 是否启用TimescaleDB分区（推荐启用）
ENABLE_TIMESCALE=true

# 分区间隔（1 day, 1 week, 1 month）
PARTITION_INTERVAL=1 day

# ============ 性能优化配置 ============
# 数据库批量插入大小
DB_BATCH_SIZE=10000

# 内存缓冲区大小（MB）
BUFFER_SIZE_MB=100

# ============ 监控配置 ============
# 进度报告间隔（处理多少天后报告一次）
PROGRESS_REPORT_INTERVAL=10

# 是否启用详细的性能统计
ENABLE_PERFORMANCE_STATS=true
